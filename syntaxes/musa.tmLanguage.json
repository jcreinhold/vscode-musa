{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "GENERATED by build/generate-grammar.js from the musa repository’s highlighting fixtures — do not edit. Patterns trace to crates/musa-syntax/src/lexer.rs.",
  "name": "musa",
  "scopeName": "source.musa",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#string"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#use"
    },
    {
      "include": "#units"
    },
    {
      "include": "#pitch"
    },
    {
      "include": "#interval"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#separators"
    },
    {
      "include": "#name"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.musa",
          "match": "//[^\\n]*"
        },
        {
          "name": "comment.block.musa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.musa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musa",
          "match": "\\\\[^\\n]"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "begin": "\\b(import|mod)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.musa"
            }
          },
          "end": ";",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#string"
            },
            {
              "name": "keyword.control.musa",
              "match": "\\bas\\b"
            },
            {
              "name": "punctuation.separator.musa",
              "match": "::"
            },
            {
              "name": "variable.other.musa",
              "match": "\\b(harmony|performance|pitch|scale|[a-zA-Z_][a-zA-Z_0-9]*)\\b"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.musa",
          "match": "\\b(Err|List|None|Ok|Option|Result|Some|around|arranger|as|assert|assign|at|bar|bus|chord|clef|composer|copyright|crescendo|data|degree|diminuendo|down|dynamic|else|ending|enum|events|false|fn|fragment|frame|grace|groove|harmony|if|impl|import|improvise|in|invert|key|let|mark|master|match|meter|mobile|mod|modulate|motif|music|note|output|over|part|patch|performance|phrase|piece|pitch|private|profile|quote|record|repeat|rest|retrograde|route|scale|score|section|send|senza|slur|stack|step|stretch|studio|subtitle|syntax|tempo|to|transpose|true|tuplet|up|voice|with)\\b"
        }
      ]
    },
    "use": {
      "patterns": [
        {
          "name": "keyword.control.import.musa",
          "match": "\\buse\\b"
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "constant.other.unit.musa",
          "match": "\\b(Hz|bpm|dB|ms|s)\\b"
        }
      ]
    },
    "pitch": {
      "patterns": [
        {
          "name": "constant.other.pitch.musa",
          "match": "\\b[a-g](#+|b+|n)?-?[0-9]+\\b"
        }
      ]
    },
    "interval": {
      "patterns": [
        {
          "name": "constant.other.pitch.musa",
          "match": "\\b(P|M|m|A+|d{2,}|dim)[0-9]+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.musa",
          "match": "/[0-9]+\\.*"
        },
        {
          "name": "constant.numeric.duration.musa",
          "match": "\\b[0-9]+/[0-9]+\\b"
        },
        {
          "name": "constant.numeric.musa",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.musa",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.musa",
          "match": "->|==|\\|>|-|\\?|\\*|\\+|=|~"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.musa",
          "match": "\\(|\\)|\\[|\\]|\\{|\\}"
        }
      ]
    },
    "separators": {
      "patterns": [
        {
          "name": "punctuation.separator.musa",
          "match": "#|\\$|,|\\.|/|:|;|<|>|\\^|\\|"
        }
      ]
    },
    "name": {
      "patterns": [
        {
          "name": "variable.other.musa",
          "match": "[a-zA-Z_][a-zA-Z_0-9]*"
        }
      ]
    }
  }
}
