{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "GENERATED by build/generate-grammar.js from the musa repository’s highlighting fixtures — do not edit. Patterns trace to crates/musa-language/src/lexer.rs.",
  "name": "musa",
  "scopeName": "source.musa",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#string"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#use"
    },
    {
      "include": "#units"
    },
    {
      "include": "#pitch"
    },
    {
      "include": "#interval"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#separators"
    },
    {
      "include": "#name"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.musa",
          "match": "//[^\\n]*"
        },
        {
          "name": "comment.block.musa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.musa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musa",
          "match": "\\\\[^\\n]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.musa",
          "match": "\\b(around|arranger|assign|at|bar|bus|clef|composer|copyright|crescendo|diminuendo|down|dynamic|ending|false|fn|fragment|grace|groove|harmony|improvise|invert|key|let|library|list|mark|master|match|meter|mobile|modulate|motif|music|none|note|option|output|over|part|patch|performance|phrase|piece|pitch|profile|repeat|rest|retrograde|route|score|section|send|senza|slur|some|stretch|studio|subtitle|tempo|to|transpose|true|tuplet|up|voice|with)\\b"
        }
      ]
    },
    "use": {
      "patterns": [
        {
          "name": "keyword.control.import.musa",
          "match": "\\buse\\b"
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "constant.other.unit.musa",
          "match": "\\b(Hz|bpm|dB|ms|s)\\b"
        }
      ]
    },
    "pitch": {
      "patterns": [
        {
          "name": "constant.other.pitch.musa",
          "match": "\\b[a-g](##|bb|[#bn])?-?[0-9]+\\b"
        }
      ]
    },
    "interval": {
      "patterns": [
        {
          "name": "constant.other.pitch.musa",
          "match": "\\b[PMm][0-9]+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.musa",
          "match": "/[0-9]+\\.*"
        },
        {
          "name": "constant.numeric.duration.musa",
          "match": "\\b[0-9]+/[0-9]+\\b"
        },
        {
          "name": "constant.numeric.musa",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.musa",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.musa",
          "match": "-|->|=|\\|>|~"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.musa",
          "match": "\\(|\\)|\\[|\\]|\\{|\\}"
        }
      ]
    },
    "separators": {
      "patterns": [
        {
          "name": "punctuation.separator.musa",
          "match": "#|,|\\.|/|:|;|>|\\^|\\|"
        }
      ]
    },
    "name": {
      "patterns": [
        {
          "name": "variable.other.musa",
          "match": "[a-zA-Z_]+"
        }
      ]
    }
  }
}
